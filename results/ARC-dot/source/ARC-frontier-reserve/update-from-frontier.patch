@@ -0,0 +1,69 @@
+from dataclasses import replace
+import unittest
+
+from maze.environment import Environment, Status
+from maze.frontier_reserve import ReserveFrontier, _optimistic, _service_floors, _relaxed_route
+from maze.grid import destination, locations
+from maze.interface import Move
+from maze.levels import Level
+from maze.pilot_automaton import Mode
+from maze.runner import run
+from scripts.audit_automaton import Reachability
+
+
+class FrontierReserveTests(unittest.TestCase):
+    def test_reaching_either_service_is_not_a_feasible_service_chain(self):
+        grid = ("#########", "#F.A.R.B#", "#########")
+        stops = (((1, 1), "F"), ((5, 1), "R"), ((7, 1), "B"))
+        self.assertFalse(_relaxed_route(grid, (3, 1), (7, 1), 3, 3, stops, {}))
+        self.assertTrue(_relaxed_route(grid, (3, 1), (7, 1), 3, 7, stops, {}))
+
+    def test_relaxation_includes_successful_physically_legal_moves(self):
+        levels = (
+            "Развилка\n5 7\n#########\n#F.A.R.B#\n#...#...#\n#########",
+            "Развилка\n7 5\n#########\n#B.R.A.F#\n#...#...#\n#########",
+        )
+        for source in levels:
+            level = Level.parse(source)
+            for first in (None, Move.WEST, Move.EAST, Move.SOUTH):
+                env = Environment(level)
+                previous = {}
+                if first is not None and destination(level.grid, level.start, first):
+                    previous = {Mode.FUEL: env.view.fuel_distance, Mode.REPAIR: env.view.repair_distance}
+                    env.step(first)
+                view = env.view
+                oracle = Reachability(level)
+                targets = [(p, kind) for kind in "FRB" for p in locations(level.grid, kind)]
+                for move in Move:
+                    q = destination(view.memory, view.position, move)
+                    if q is None:
+                        continue
+                    stocks = oracle.after(q, view.fuel, view.health)
+                    if oracle.possible(q, *stocks, env.limit - env.steps - 1):
+                        with self.subTest(source=source, first=first, move=move):
+                            self.assertTrue(_relaxed_route(
+                                _optimistic(view.memory), q, level.goal, *stocks, targets,
+                                _service_floors(view, previous, q)))
+
+    def test_stall_probe_requires_an_observed_escape(self):
+        # В модели открыты середина коридора и ближний сервис, но не
+        # подход ко второму. Граница справа даёт новое наблюдение.
+        level = Level.parse("Коридор\n12 12\n###########\n#F.A...R.B#\n###########")
+        view = replace(Environment(level).view,
+                       memory=("###########", "#F.A..?R.B#", "###########"))
+        bot = ReserveFrontier()
+        stops = (((1, 1), "F"), ((7, 1), "R"))
+        bot._service_streak = 3
+        self.assertIsNone(bot._extra_plan(view, level.goal, stops))
+        bot._service_streak = 4
+        self.assertEqual(bot._extra_plan(view, level.goal, stops)[1], Move.EAST)
+        self.assertIsNone(bot._extra_plan(replace(view, health=3), level.goal, stops))
+
+    def test_same_observation_does_not_reveal_hidden_geometry(self):
+        a = Environment(Level.parse("Коридор\n9 9\n######\n#A..B#\n######"))
+        b = Environment(Level.parse("Тупик\n9 9\n######\n#A.#B#\n######"))
+        self.assertEqual(a.view, b.view)
+        player = ReserveFrontier()
+        first = player.choose(a.view)
+        self.assertEqual(run(a, player), Status.SUCCESS)
+        self.assertEqual(player.choose(b.view), first)
