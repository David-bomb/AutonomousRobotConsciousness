@@ -0,0 +1,135 @@
+"""Сравнение четырёх контроллеров без изменения архивных результатов."""
+import argparse
+from collections import Counter
+import csv
+from dataclasses import dataclass
+from functools import partial
+from hashlib import sha256
+import json
+from pathlib import Path
+
+from maze.automaton import Automaton, ResourceAutomaton
+from maze.datasets import Case, development_sets, geometry
+from maze.environment import Environment, Status
+from maze.frontier_automaton import FrontierAutomaton
+from maze.interface import Move, Observation
+from maze.levels import catalogue
+from maze.sarsa import Sarsa
+from scripts.audit_automaton import Reachability, independent_cases
+
+ROOT = Path(__file__).resolve().parents[1]
+POLICY = ROOT / "results/E-0001/run-02/policy.json"
+HOLDOUT_SEED = 91462713
+CONTROLLER = ROOT / "maze/frontier_automaton.py"
+
+
+@dataclass(frozen=True)
+class Transition:
+    before: Observation
+    move: Move
+    after: Observation
+    activity: str | None
+
+
+def first_irreversible(oracle, limit, history):
+    def possible(view, remaining):
+        return oracle.possible(view.position, view.fuel, view.health, remaining)
+
+    if not possible(history[0].before, limit):
+        return {"initially_feasible": False}
+    # Once no successful suffix exists, taking another action cannot restore
+    # reachability under the same time and resource limits.
+    lo, hi = 0, len(history) - 1
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if possible(history[mid].after, limit - mid - 1):
+            lo = mid + 1
+        else:
+            hi = mid
+    event = history[lo]
+    before = event.before
+    options = []
+    for move, p in oracle.edges[before.position]:
+        fuel, health = oracle.after(p, before.fuel, before.health)
+        if oracle.possible(p, fuel, health, limit - lo - 1):
+            options.append(move.name)
+    return dict(initially_feasible=True, step=lo + 1, position=before.position,
+                move=event.move.name, activity=event.activity, fuel=before.fuel,
+                health=before.health, fuel_distance=before.fuel_distance,
+                repair_distance=before.repair_distance, viable=options)
+
+
+def measure(case, name, factory, oracle):
+    env = Environment(case.level)
+    agent = factory()
+    history = []
+    while env.status == Status.RUNNING:
+        before = env.view
+        move = agent.choose(before)
+        history.append(Transition(before, move, env.step(move), getattr(agent, "activity", None)))
+    row = dict(case=case.name, stage=case.stage, agent=name, status=env.status.name,
+               steps=env.steps, refuels=env.refuels, repairs=env.repairs,
+               invalid=sum(not t.after.moved for t in history),
+               opened=sum(c != "?" for row in env.view.memory for c in row)
+               - sum(c != "?" for row in history[0].before.memory for c in row))
+    failure = None if env.status == Status.SUCCESS else first_irreversible(oracle, env.limit, history)
+    return row, failure
+
+
+def groups(requested):
+    train, val = development_sets()
+    if "train" in requested:
+        yield "train", train
+    if "val" in requested:
+        yield "val", val
+    if "archive" in requested:
+        yield "archive", [Case(name, 0, level) for name, level in catalogue().items()]
+    if {"confirm", "holdout"} & requested:
+        older = independent_cases(train, val)
+        confirm = independent_cases(train, val, 25112027, [geometry(c.level.grid) for c in older])
+        if "confirm" in requested:
+            yield "confirm", confirm
+        if "holdout" in requested:
+            yield "holdout", independent_cases(train, val, HOLDOUT_SEED,
+                                               [geometry(c.level.grid) for c in older + confirm])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("output", type=Path, help="новой папки, не существующей до запуска")
+    parser.add_argument("--split", nargs="+", choices=("train", "val", "archive", "confirm", "holdout"),
+                        default=("train", "val", "archive", "confirm", "holdout"))
+    args = parser.parse_args()
+    args.output.mkdir(parents=True)
+    policy_bytes = POLICY.read_bytes()
+    source_hash = sha256(CONTROLLER.read_bytes()).hexdigest()
+    policy = json.loads(policy_bytes)["values"]
+    factories = {"pilot": Automaton, "resources": ResourceAutomaton,
+                 "sarsa": partial(Sarsa, policy), "frontier": FrontierAutomaton}
+    metadata = {"controller_sha256": source_hash, "policy_sha256": sha256(policy_bytes).hexdigest(),
+                "holdout_seed": HOLDOUT_SEED, "splits": {}, "failures": []}
+    with (args.output / "episodes.csv").open("x", encoding="utf-8", newline="") as f:
+        writer = None
+        for group, cases in groups(set(args.split)):
+            metadata["splits"][group] = {c.name: geometry(c.level.grid) for c in cases}
+            summary = {name: Counter() for name in factories}
+            for case in cases:
+                oracle = Reachability(case.level)
+                for name, factory in factories.items():
+                    row, failure = measure(case, name, factory, oracle)
+                    row = dict(split=group, **row)
+                    if writer is None:
+                        writer = csv.DictWriter(f, fieldnames=list(row))
+                        writer.writeheader()
+                    writer.writerow(row)
+                    summary[name][row["status"]] += 1
+                    if failure:
+                        metadata["failures"].append(dict(split=group, case=case.name, agent=name, **failure))
+            f.flush()
+            print(group, {name: dict(counts) for name, counts in summary.items()}, flush=True)
+    (args.output / "diagnosis.json").write_text(
+        json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
