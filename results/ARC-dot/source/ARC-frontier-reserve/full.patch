@@ -0,0 +1,64 @@
+"""Парное сравнение замороженных frontier и frontier-reserve."""
+import argparse
+from collections import Counter
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+
+from maze.datasets import development_sets, geometry
+from maze.frontier_automaton import FrontierAutomaton
+from maze.frontier_reserve import ReserveFrontier
+from scripts.audit_automaton import Reachability, independent_cases
+from scripts.evaluate_frontier import HOLDOUT_SEED, groups, measure
+
+SEED = 68319041
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def fresh():
+    train, val = development_sets()
+    used = set()
+    for seed in (25112026, 25112027, HOLDOUT_SEED):
+        used.update(geometry(c.level.grid) for c in independent_cases(train, val, seed, used))
+    return independent_cases(train, val, SEED, used)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("output", type=Path, help="новая папка")
+    p.add_argument("--split", choices=("fresh", "train", "val", "archive", "confirm", "holdout"),
+                   default="fresh")
+    args = p.parse_args()
+    args.output.mkdir(parents=True)
+    cases = fresh() if args.split == "fresh" else next(groups({args.split}))[1]
+    agents = {"frontier": FrontierAutomaton, "frontier-reserve": ReserveFrontier}
+    metadata = {
+        "seed": SEED if args.split == "fresh" else None,
+        "split": args.split,
+        "source_sha256": {name: sha256((ROOT / name).read_bytes()).hexdigest()
+                          for name in ("maze/frontier_automaton.py", "maze/frontier_reserve.py")},
+        "geometries": {c.name: geometry(c.level.grid) for c in cases},
+        "failures": [],
+    }
+    summary = {name: Counter() for name in agents}
+    with (args.output / "episodes.csv").open("x", encoding="utf-8", newline="") as f:
+        writer = None
+        for case in cases:
+            oracle = Reachability(case.level)
+            for name, factory in agents.items():
+                row, failure = measure(case, name, factory, oracle)
+                if writer is None:
+                    writer = csv.DictWriter(f, fieldnames=list(row))
+                    writer.writeheader()
+                writer.writerow(row)
+                summary[name][row["status"]] += 1
+                if failure:
+                    metadata["failures"].append(dict(case=case.name, agent=name, **failure))
+    (args.output / "diagnosis.json").write_text(
+        json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(args.split, {name: dict(counts) for name, counts in summary.items()})
+
+
+if __name__ == "__main__":
+    main()
