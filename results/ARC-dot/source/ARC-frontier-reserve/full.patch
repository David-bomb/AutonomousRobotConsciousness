+import unittest
+
+from maze.datasets import load_split
+from maze.environment import Environment, Status
+from maze.frontier_automaton import FrontierAutomaton, _arrive, _near_goal
+from maze.interface import Move
+from maze.levels import Level, catalogue
+from maze.runner import run
+
+
+class FrontierAutomatonTests(unittest.TestCase):
+    def test_arrival_checks_the_nonreset_resource(self):
+        self.assertEqual(_arrive("F", 3, 3, 4), (100, 1))
+        self.assertIsNone(_arrive("F", 3, 3, 3))
+        self.assertIsNone(_arrive("R", 3, 3, 3))
+        self.assertIsNone(_arrive(".", 3, 3, 4))
+        self.assertEqual(_arrive("B", 3, 3, 3), (0, 0))
+
+    def test_probe_beyond_the_window_but_not_through_a_known_wall(self):
+        def view(row):
+            return Environment(Level.parse(f"Коридор\n9 9\n#####\n{row}\n#####")).view
+        self.assertEqual(_near_goal(view("#A.B#"), (3, 1)), Move.EAST)
+        self.assertIsNone(_near_goal(view("#A#B#"), (3, 1)))
+
+    def test_same_first_move_with_same_observation(self):
+        open_map = Environment(Level.parse("Открыто\n9 9\n######\n#A..B#\n######"))
+        hidden_wall = Environment(Level.parse("Стена\n9 9\n######\n#A.#B#\n######"))
+        self.assertEqual(open_map.view, hidden_wall.view)
+        agent = FrontierAutomaton()
+        first = agent.choose(open_map.view)
+        agent.choose(open_map.step(first))
+        self.assertEqual(agent.choose(hidden_wall.view), first)
+
+    def test_regression_on_known_failures(self):
+        cases = {c.name: c.level for c in load_split("val")}
+        cases.update(catalogue())
+        for name in ("val-3-10", "08-galleries", "09-switchbacks"):
+            with self.subTest(name=name):
+                env = Environment(cases[name])
+                self.assertEqual(run(env, FrontierAutomaton()), Status.SUCCESS)
+
+
+if __name__ == "__main__":
+    unittest.main()
