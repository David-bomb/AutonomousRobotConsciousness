+"""Сравнить frontier, reserve и фиксированный guarded без записи в старые результаты."""
+import argparse
+from collections import Counter
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+
+from maze.datasets import development_sets, geometry
+from maze.frontier_automaton import FrontierAutomaton
+from maze.frontier_guarded import (GuardedBase, GuardedEvidence, GuardedExcursion,
+                                   GuardedExcursionOnly, GuardedProbe, GuardedReserve)
+from maze.frontier_reserve import ReserveFrontier
+from scripts.audit_automaton import Reachability, independent_cases
+from scripts.compare_frontier_reserve import SEED as RESERVE_SEED
+from scripts.evaluate_frontier import HOLDOUT_SEED, groups, measure
+
+SEED = 52718463
+ROOT = Path(__file__).resolve().parents[1]
+AGENTS = {"frontier": FrontierAutomaton, "reserve": ReserveFrontier,
+          "A": GuardedBase, "B": GuardedReserve, "C": GuardedProbe, "D": GuardedEvidence, "E": GuardedExcursion, "F": GuardedExcursionOnly}
+
+
+def selected_cases(split):
+    if split not in ("fresh", "reserve-fresh"):
+        return next(groups({"archive" if split == "test" else split}))[1]
+    train, val = development_sets()
+    used = set()
+    for seed in (25112026, 25112027, HOLDOUT_SEED):
+        used.update(geometry(c.level.grid) for c in independent_cases(train, val, seed, used))
+    earlier = independent_cases(train, val, RESERVE_SEED, used)
+    if split == "reserve-fresh":
+        return earlier
+    used.update(geometry(c.level.grid) for c in earlier)
+    return independent_cases(train, val, SEED, used)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--split", choices=("train", "val", "test", "holdout", "reserve-fresh", "fresh"),
+                        required=True)
+    parser.add_argument("--agents", nargs="+", choices=tuple(AGENTS), required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True)
+    cases = selected_cases(args.split)
+    sources = ("frontier_automaton.py", "frontier_reserve.py", "frontier_guarded.py")
+    records = {
+        "split": args.split,
+        "seed": SEED if args.split == "fresh" else None,
+        "geometries": {case.name: geometry(case.level.grid) for case in cases},
+        "sha256": {name: sha256((ROOT / "maze" / name).read_bytes()).hexdigest() for name in sources},
+        "failures": [],
+    }
+    for name in args.agents:
+        counts = Counter()
+        with (args.output / f"{name}.csv").open("x", encoding="utf-8", newline="") as stream:
+            writer = None
+            for case in cases:
+                oracle = Reachability(case.level)
+                row, diag = measure(case, name, AGENTS[name], oracle)
+                if writer is None:
+                    writer = csv.DictWriter(stream, fieldnames=list(row))
+                    writer.writeheader()
+                writer.writerow(row)
+                counts[row["status"]] += 1
+                if diag:
+                    records["failures"].append(dict(case=case.name, agent=name, **diag))
+        print(args.split, name, dict(counts), flush=True)
+    (args.output / "diagnosis.json").write_text(
+        json.dumps(records, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
