+from dataclasses import replace
+from types import SimpleNamespace
+import unittest
+
+from maze.environment import Environment
+from maze.frontier_guarded import Guard, GuardedEvidence
+from maze.interface import Move
+from maze.levels import Level
+
+
+class ProposedEscape:
+    def __init__(self):
+        self._fallback = SimpleNamespace(last_lengths={}, returning=False)
+
+    def choose(self, view):
+        self.activity = "Проба в режиме выхода из застоя"
+        return Move.EAST
+
+
+class GuardedEscape(Guard, ProposedEscape):
+    pass
+
+
+class GuardedTests(unittest.TestCase):
+    def test_guard_runs_after_a_stagnation_probe(self):
+        level = Level.parse("Коридор\n4 20\n#############\n#F...A.....B#\n#############")
+        view = replace(Environment(level).view, memory=level.grid)
+        self.assertEqual(view.fuel_distance, 4)
+        self.assertEqual(GuardedEscape().choose(view), Move.WEST)
+
+    def test_certificate_is_only_for_tight_resources(self):
+        level = Level.parse("Коридор\n4 20\n#############\n#F...A.....B#\n#############")
+        view = Environment(level).view
+        agent = GuardedEvidence()
+        self.assertEqual(agent._critical(view), (("F", 4),))
+        self.assertEqual(agent._critical(replace(view, fuel=6)), ())
